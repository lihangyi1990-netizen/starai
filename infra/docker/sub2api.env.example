# Copy to infra/docker/.env.sub2api. Never commit the copied file.
SUB2API_PORT=8081
SUB2API_POSTGRES_USER=sub2api
SUB2API_POSTGRES_DB=sub2api
SUB2API_POSTGRES_PASSWORD=replace-with-a-long-random-password
SUB2API_ADMIN_EMAIL=admin@pico.local
# AUTO_SETUP=true creates the account on first boot. Set this false to use the
# first-run web setup wizard and choose the administrator email and password.
SUB2API_AUTO_SETUP=true
# Optional with automatic setup: an empty value creates a one-time password in
# the container logs. It is unused when SUB2API_AUTO_SETUP=false.
SUB2API_ADMIN_PASSWORD=
SUB2API_JWT_SECRET=replace-with-a-64-char-random-secret
SUB2API_TOTP_ENCRYPTION_KEY=replace-with-a-64-char-random-secret

# Comma-separated official provider API hosts you are authorized to use.
# Leave empty until you configure Sub2API in its local administration console.
SUB2API_UPSTREAM_HOSTS=

# Browser URL for the Sub2API administration console. Keep this separate from
# the server-to-server PICO gateway URL; the latter may be an internal Docker
# hostname that cannot be opened by a user's browser.
PICO_SUB2API_ADMIN_URL=http://localhost:8081
