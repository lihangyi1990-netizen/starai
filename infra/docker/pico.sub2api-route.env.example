# Add these values to the untracked infra/docker/.env.sub2api only after
# configuring an authorized upstream in Sub2API and creating PICO's dedicated
# gateway token there. Until then PICO keeps using its local development mock.
PICO_NEW_API_BASE_URL=http://sub2api:8080
PICO_NEW_API_TOKEN=replace-with-a-sub2api-client-token
# When enabled, PICO refreshes its public model catalog from the dedicated
# Sub2API gateway key instead of exposing seeded demo models.
PICO_NEW_API_MODEL_CATALOG_SYNC=true
# URL that an administrator's browser can open for the separate Sub2API
# console. Do not use the internal Docker hostname here; use localhost:PORT
# for a local browser or the public HTTPS hostname in production.
PICO_SUB2API_ADMIN_URL=http://localhost:8081
